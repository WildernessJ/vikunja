{
	"$schema": "https://unpkg.com/knip@6.41.0/schema.json",
	// Histoire (pnpm story:*) loads these; knip has no Histoire plugin.
	"entry": ["histoire.config.ts", "src/histoire.setup.ts"],
	"ignore": [
		// Generated by @hey-api/openapi-ts; it exports the whole API surface.
		"src/client/generated/**",
		// Loaded through <style src> in App.vue and Vite's scss additionalData,
		// which knip does not follow.
		"src/styles/**"
	],
	"ignoreDependencies": [
		// Imported from SCSS only, which knip does not parse.
		"bulma-css-variables"
	]
}
